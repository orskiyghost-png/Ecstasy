{
  "name": "ecstasy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply ecstasy --local --persist-to .wrangler/state",
    "db:migrate:check": "wrangler d1 migrations apply ecstasy --local --persist-to /tmp/ecstasy-d1-check",
    "db:check:local": "wrangler d1 execute ecstasy --local --persist-to .wrangler/state --command \"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'users'; PRAGMA table_info(users); PRAGMA index_list(users);\"",
    "smoke:local": "node scripts/smoke-local.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true,
    "workerd@1.20261116.1": true
  }
}
